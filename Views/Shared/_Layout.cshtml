<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Учебный кабинет</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">УК</span><span>Учебный кабинет</span></a>
    <nav>
        <a asp-controller="Home" asp-action="Index">Главная</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            if (User.IsInRole("Teacher")) { <a asp-controller="Teacher" asp-action="Index">Панель преподавателя</a> }
            if (User.IsInRole("Student")) { <a asp-controller="Student" asp-action="Index">Мои дисциплины</a> }
            <span class="nav-user">@User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form"><button class="link-button" type="submit">Выйти</button></form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Войти</a>
            <a class="nav-cta" asp-controller="Account" asp-action="Register">Регистрация</a>
        }
    </nav>
</header>
<main class="page">
    @if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
    @if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }
    @RenderBody()
</main>
<footer class="footer"><span>Электронный учебный кабинет</span><span>Учись последовательно · Проверяй знания · Отслеживай прогресс</span></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
